# أسرار وإعدادات البوت
# انسخ هذا الملف إلى .env وعبّئ القيم

# ===== المتطلب الأساسي =====
BOT_TOKEN=

# ===== الأدمن والقناة =====
ADMIN_IDS=
CHANNEL_ID=-
CHANNEL_USERNAME=waleed_zone
GROUP_ID=-
GROUP_USERNAME=WALEEDzone

# Public files channel (must be the same username/ID pair).
FILES_CHANNEL_ID=
FILES_CHANNEL_USERNAME=
# If both are unset, verified CHANNEL_ID + CHANNEL_USERNAME are used.

# ===== ImgBB (رفع الصور) - مهم للترحيل =====
IMGBB_API_KEY=

# ===== BZZHR / BuzzHeavier =====
# اختياري فقط إذا كانت شبكة الاستضافة نفسها محجوبة من BuzzHeavier.
# مثال: http://user:password@proxy.example:3128
BZZHR_PROXY_URL=

# ===== قاعدة البيانات =====
# SQLite (للتطوير المحلي):
DATABASE_URL=

# PostgreSQL (للإنتاج/Railway):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ===== السلوك العام =====
MAX_UPLOAD_BYTES=2147483648
HTTP_MAX_RETRIES=3
DOWNLOAD_DIR=tmp/uploads

# ===== تكامل الموقع =====
# رابط Waleed Zone العام. البوت يستخدمه فقط لبناء روابط صفحات التطبيقات.
WEBSITE_BASE_URL=https://waleed-zone.up.railway.app
# اختياري لقراءة إحصائيات الموقع من البوت. استخدم نفس WEBSITE_STATS_TOKEN على الطرفين.
WEBSITE_STATS_URL=https://waleed-zone.up.railway.app/api/stats
WEBSITE_STATS_TOKEN=
