# أسرار وإعدادات البوت
# انسخ هذا الملف إلى .env وعبّئ القيم

# ===== المتطلب الأساسي =====
BOT_TOKEN=

# ===== الأدمن والقناة =====
ADMIN_IDS=
CHANNEL_ID=-
CHANNEL_USERNAME=waleed_zone
GROUP_ID=-
GROUP_USERNAME=WALEEDzone

# Public files channel. Username is required; numeric ID is optional and will be
# resolved/verified through Telegram when omitted.
FILES_CHANNEL_ID=
FILES_CHANNEL_USERNAME=
# If both are unset, verified CHANNEL_ID + CHANNEL_USERNAME are used.

# ===== ImgBB (رفع الصور) =====
IMGBB_API_KEY=
# ترحيل الصور يغيّر قاعدة البيانات ويتصل بخدمة خارجية؛ يُترك معطّلًا افتراضيًا.
# فعّله فقط لعملية صيانة مقصودة: RUN_IMAGE_MIGRATION_ON_STARTUP=true
RUN_IMAGE_MIGRATION_ON_STARTUP=false

# ===== BZZHR / BuzzHeavier =====
# Public HTTP only. BZZHR_PROXY_URL and browser challenge solvers are unsupported.
# Human verification fails closed; do not configure a proxy bypass.

# ===== قاعدة البيانات =====
# SQLite (للتطوير المحلي):
DATABASE_URL=

# PostgreSQL (للإنتاج/Railway):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ===== السلوك العام =====
MAX_UPLOAD_BYTES=2147483648
HTTP_MAX_RETRIES=3
DOWNLOAD_DIR=tmp/uploads

# ===== تكامل الموقع =====
# الرابط الأساسي المعتمد؛ كل روابط التطبيقات والمنشورات يجب أن تستخدم هذا الدومين.
WEBSITE_BASE_URL=https://www.waleedzone.xyz
# اختياري لقراءة إحصائيات الموقع من البوت. استخدم نفس WEBSITE_STATS_TOKEN على الطرفين.
WEBSITE_STATS_URL=https://www.waleedzone.xyz/api/stats
WEBSITE_STATS_TOKEN=

# روابط التحميل الخارجية المسموحة (اختياري). أسماء hosts فقط، مفصولة بفواصل.
# ShrinkMe وDevUploads محظوران دائمًا ولا يمكن تفعيلهما من الإعدادات.
EXTERNAL_DOWNLOAD_ALLOWED_HOSTS=
