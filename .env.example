# أسرار وإعدادات البوت
# انسخ هذا الملف إلى .env وعبّئ القيم

# ===== المتطلب الأساسي =====
BOT_TOKEN=

# ===== الأدمن والقناة =====
ADMIN_IDS=
CHANNEL_ID=-
CHANNEL_USERNAME=waleed_zone
GROUP_ID=-
GROUP_USERNAME=WALEEDzone

# ===== Dev Uploads (رفع التطبيقات) =====
DEVUPLOAD_API_KEY=
DEVUPLOAD_BASE_URL=https://devuploads.com
DEVUPLOAD_TIMEOUT=600

# ===== ShrinkMe (تقصير الروابط) =====
SHRANKME_API_KEY= 
SHRANKME_API_URL=https://shrinkme.io/st
SHRANKME_LEGACY_API_URL=https://shrinkme.io/api
SHRANKME_TIMEOUT=60

# ===== ImgBB (رفع الصور) - مهم للترحيل =====
IMGBB_API_KEY=

# ===== BZZHR / BuzzHeavier =====
# اختياري فقط إذا كانت شبكة الاستضافة نفسها محجوبة من BuzzHeavier.
# مثال: http://user:password@proxy.example:3128
BZZHR_PROXY_URL=

# ===== قاعدة البيانات =====
# SQLite (للتطوير المحلي):
DATABASE_URL=

# PostgreSQL (للإنتاج/Railway):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ===== السلوك العام =====
MAX_UPLOAD_BYTES=2147483648
HTTP_MAX_RETRIES=3
DOWNLOAD_DIR=tmp/uploads
